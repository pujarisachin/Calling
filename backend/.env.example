APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_BASE_URL=
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./voice_test.db

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional alternative auth (recommended for production):
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
# Optional. Leave empty when public tunnel is unavailable.
TWILIO_STATUS_CALLBACK_URL=
TWILIO_ANSWER_URL=
# Used only when TWILIO_ANSWER_URL is empty (inline TwiML fallback mode).
TWILIO_INLINE_HOLD_SECONDS=45

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2025-08-28
OPENAI_REALTIME_VOICE=alloy
